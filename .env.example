# Copy to .env and fill in. .env is gitignored and never committed.
# An existing environment variable always wins over anything here.

OPENAI_API_KEY=sk-...

# Optional
# DILIGENCE_KERNEL_PROVIDER=openai        # or anthropic
# DILIGENCE_KERNEL_MODEL=gpt-5
# DILIGENCE_KERNEL_EFFORT=medium          # low | medium | high | xhigh | max
# DILIGENCE_KERNEL_OCR=tesseract          # auto | tesseract | vision | off
